@using LMS.System.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

<MudNavMenu>
	<MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>

	@if (userRole == UserRole.Admin || userRole == UserRole.Teacher)
	{
		<MudNavLink Href="courses" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.School">Manage Courses</MudNavLink>
		<MudNavLink Href="users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Users</MudNavLink>
	}

	@if (userRole == UserRole.Student)
	{
		<MudNavLink Href="my-courses" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Book">My Courses</MudNavLink>
		<MudNavLink Href="assignments" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assignment">Assignments</MudNavLink>
	}

	<MudNavLink Href="profile" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">Profile</MudNavLink>
</MudNavMenu>

@code {

	[Parameter]
	public UserRole? UserRole { get; set; }

	private UserRole userRole = UserRole.Student;

	protected override void OnParametersSet()
	{
		if (UserRole != null)
		{
			userRole = UserRole;
		}
	}
}